# SCHILD Environment Configuration Template
# Copy this file to .env and fill in your values.
# Command: cp .env.example .env

# ─────────────────────────────────────────────
# AI Provider Selection
# ─────────────────────────────────────────────
# Choose one: openai | anthropic | gemini | ollama
SCHILD_AI_PROVIDER=openai

# Model overrides (optional — defaults are set in config.py)
SCHILD_TRIAGE_MODEL=gpt-4o-mini
SCHILD_ANALYST_MODEL=gpt-4o

# Anthropic model overrides
SCHILD_ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5
SCHILD_ANTHROPIC_ANALYST_MODEL=claude-sonnet-4-5

# Gemini model overrides
SCHILD_GEMINI_TRIAGE_MODEL=gemini-1.5-flash
SCHILD_GEMINI_ANALYST_MODEL=gemini-1.5-pro

# Ollama model overrides (model yang sudah di-pull via: ollama pull <model>)
# Contoh model: llama3, llama3.1, mistral, qwen2, gemma2, deepseek-r1, dll.
SCHILD_OLLAMA_TRIAGE_MODEL=llama3
SCHILD_OLLAMA_ANALYST_MODEL=llama3

# ─────────────────────────────────────────────
# API Keys — AI Providers
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# Ollama (Local / Self-hosted LLM)
# ─────────────────────────────────────────────
# URL server Ollama (default: lokal di port 11434)
OLLAMA_BASE_URL=http://localhost:11434
# Opsional: hanya diperlukan jika server Ollama remote menggunakan autentikasi
# OLLAMA_API_KEY=

# ─────────────────────────────────────────────
# API Keys — Threat Intelligence
# ─────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=

# ─────────────────────────────────────────────
# Defense Mode
# ─────────────────────────────────────────────
# observe   → Log only, no automated actions
# hunt      → Proactive hunting, no auto-remediation (default)
# contain   → Auto-isolate threats, confirm kills
# eliminate → Fully autonomous response (USE WITH CAUTION)
SCHILD_DEFENSE_MODE=hunt

# ─────────────────────────────────────────────
# Database & Storage
# ─────────────────────────────────────────────
SCHILD_DB_PATH=schild_memory.db

# ─────────────────────────────────────────────
# Timeouts (seconds)
# ─────────────────────────────────────────────
SCHILD_TRIAGE_TIMEOUT=30
SCHILD_ANALYST_TIMEOUT=120
SCHILD_TOOL_TIMEOUT=30

# ─────────────────────────────────────────────
# Investigation & Hunting
# ─────────────────────────────────────────────
SCHILD_MAX_HUNT_STEPS=8

# ─────────────────────────────────────────────
# Anomaly Detection
# ─────────────────────────────────────────────
# Z-score threshold — higher = less sensitive (3.0 recommended)
SCHILD_ANOMALY_ZSCORE=3.0
# How often to sample baseline metrics (seconds)
SCHILD_BASELINE_INTERVAL=60
# Number of samples before baseline is considered stable
SCHILD_BASELINE_WARMUP=20

# ─────────────────────────────────────────────
# REST API Backend (schild --serve)
# ─────────────────────────────────────────────
SCHILD_API_HOST=0.0.0.0
SCHILD_API_PORT=8420
# API authentication token. Leave empty to disable auth (dev mode only).
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHILD_API_SECRET=
